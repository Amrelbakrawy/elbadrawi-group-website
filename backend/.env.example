# Backend environment variables

# Resend API key for quote notifications
RESEND_API_KEY=re_xxxxxxxxx

# Admin recipient and sender email settings
ADMIN_EMAIL=info@elbadrawigroup.net
RESEND_FROM_EMAIL=quotes@elbadrawigroup.net

# Admin authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-before-launch
ADMIN_SESSION_SECRET=change-this-before-launch
ADMIN_TOKEN_TTL_HOURS=12

# Server and CORS
PORT=3000
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY=false

# Storage
QUOTES_STORAGE_DRIVER=file
QUOTES_STORAGE_PATH=./backend/runtime/quotes.json

# Abuse protection / request sizing
JSON_BODY_LIMIT=24kb
QUOTE_RATE_LIMIT_WINDOW_MS=900000
QUOTE_RATE_LIMIT_MAX_REQUESTS=5
ADMIN_LOGIN_RATE_LIMIT_WINDOW_MS=900000
ADMIN_LOGIN_RATE_LIMIT_MAX_REQUESTS=10
